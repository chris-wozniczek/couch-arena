{
  "name": "couch-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kinect Sports-style webcam boxing in the browser",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/copy-mediapipe.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p convex/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "predev": "node scripts/copy-mediapipe.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "convex": "^1.46.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
